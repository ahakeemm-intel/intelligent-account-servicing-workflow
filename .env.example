# ── Running Mode ─────────────────────────────────────────────────────────────
# APP_MODE: local | cloud | docker
APP_MODE=local

# ── LLM Provider ─────────────────────────────────────────────────────────────
# LLM_PROVIDER: ollama | openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_VISION_MODEL=llava

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── OCR Provider ──────────────────────────────────────────────────────────────
# OCR_PROVIDER: tesseract | textract
OCR_PROVIDER=tesseract

# AWS Textract (only needed when OCR_PROVIDER=textract)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Database ─────────────────────────────────────────────────────────────────
# DB_TYPE: sqlite | postgres
DB_TYPE=sqlite
SQLITE_PATH=./data/iasw.db

# PostgreSQL (only needed when DB_TYPE=postgres)
DATABASE_URL=postgresql+asyncpg://iasw:iasw@localhost:5432/iasw

# ── Confidence Score Thresholds ───────────────────────────────────────────────
CONFIDENCE_PASS_THRESHOLD=0.90
CONFIDENCE_FLAG_THRESHOLD=0.60

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/iasw.log

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── FileNet Mock ─────────────────────────────────────────────────────────────
FILENET_STORE_PATH=./filenet_store

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
